{
  "name": "@llm-usage/cli",
  "version": "1.1.0",
  "description": "See whether your Claude subscription costs more or less than pay-as-you-go. Local, private.",
  "type": "module",
  "bin": {
    "llm-usage": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "claude",
    "claude-code",
    "usage",
    "cost",
    "llm",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beastllama/llm-usage-analyzer.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
