{
  "name": "llm-usage-analyzer",
  "version": "1.2.0",
  "description": "See whether your AI plans (Claude, ChatGPT, Cursor) cost more or less than pay-as-you-go. Reads Claude Code, Codex CLI and Gemini CLI history. Local, private.",
  "type": "module",
  "bin": {
    "llm-usage-analyzer": "dist/index.js"
  },
  "files": [
    "dist",
    "web",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "prepublishOnly": "npm --prefix ../.. run build:app && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "chatgpt",
    "openai",
    "gemini",
    "gemini-cli",
    "cursor",
    "usage",
    "cost",
    "pricing",
    "subscription",
    "token",
    "llm",
    "cli"
  ],
  "author": "beastllama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beastllama/llm-usage-analyzer.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/beastllama/llm-usage-analyzer#readme",
  "bugs": {
    "url": "https://github.com/beastllama/llm-usage-analyzer/issues"
  }
}
